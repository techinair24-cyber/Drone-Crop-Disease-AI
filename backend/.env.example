# Local backend configuration
DATABASE_PATH=data/detections.sqlite3
UPLOADS_PATH=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
MAX_UPLOAD_BYTES=10485760
GPS_MAX_SKEW_SECONDS=30

# Optional: point to a local Hugging Face image-classification model directory.
# The directory must contain config.json, model weights, and image processor files.
MODEL_PATH=
MODEL_NAME=Local image classifier
MODEL_VERSION=
MODEL_SCORE_THRESHOLD=0.55

# Production: configure DATABASE_PATH and UPLOADS_PATH on a persistent disk,
# or migrate to managed PostgreSQL plus object storage before scaling horizontally.
